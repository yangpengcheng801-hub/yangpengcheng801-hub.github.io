# 阿里云百炼（DashScope 兼容模式）
# 复制为 .env.local 并填入你的 Key
OPENAI_API_KEY=sk-你的百炼密钥
VITE_OPENAI_API_KEY=sk-你的百炼密钥
VITE_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 首选模型（不可用或额度用尽时会自动尝试百炼列表中的其他模型）
VITE_AI_MODEL=qwen-plus

# 云同步（Supabase 免费版即可，可选）
# 1. 注册 https://supabase.com 创建项目
# 2. SQL Editor 执行 scripts/supabase-schema.sql
# 3. Settings → API 复制 URL 和 anon public key
VITE_SUPABASE_URL=https://你的项目.supabase.co
VITE_SUPABASE_ANON_KEY=你的anon密钥

# —— 打 APK（手机独立联网，无需电脑）——
# 1. 在 .env.local 填好 VITE_OPENAI_API_KEY
# 2. 运行 npm run cap:apk
# Key 会打进安装包，手机有网即可用 AI 例句

# —— 仅网页部署时需要（APK 不用填）——
# VITE_API_PROXY_BASE=https://你的域名.vercel.app
