{
  "name": "cet4-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "node scripts/build-dictionary.mjs && node scripts/build-forty-articles.mjs && node scripts/build-essay-materials.mjs && node scripts/generate-pwa-icons.mjs && node scripts/audit-data-quality.mjs && tsc -b && vite build",
    "build:articles": "node scripts/build-forty-articles.mjs",
    "build:essays": "node scripts/build-essay-materials.mjs",
    "audit:essays": "node scripts/audit-essay-materials.mjs",
    "audit:data": "node scripts/audit-data-quality.mjs",
    "build:essays:full": "node scripts/build-essay-materials.mjs && node scripts/audit-essay-materials.mjs",
    "lint": "eslint .",
    "test:smoke": "node scripts/smoke-test.mjs",
    "preview": "vite preview --host",
    "serve:phone": "npm run build && vite preview --host --port 4173",
    "start:prod": "node scripts/production-server.mjs",
    "sync:pdf": "node scripts/sync-pdfs.mjs",
    "sync:hf": "node scripts/build-hf-words-ranked.mjs --quick",
    "sync:hf:full": "node scripts/build-hf-words-ranked.mjs",
    "sync:dict": "node scripts/build-dictionary.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "cap:apk": "npm run cap:sync && node scripts/build-apk.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.0",
    "@capacitor/android": "^8.3.4",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@capacitor/local-notifications": "^8.2.0",
    "@supabase/supabase-js": "^2.106.2",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
