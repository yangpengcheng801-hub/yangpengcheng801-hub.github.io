# 阿里云百炼兼容 OpenAI 接口（国内网络可访问）
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=请填写你自己的百炼_API_Key
LLM_MODEL_NAME=qwen-plus
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=90
LLM_MAX_INPUT_CHARS=60000

# 本地模型：相对 backend 目录，不访问 Hugging Face
EMBEDDING_MODEL_NAME=./models/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=./models/bge-reranker-base
HF_ENDPOINT=

# 本地数据目录：全部为相对 backend 的路径
VECTOR_DB_PATH=./data/vector_db
UPLOAD_DIR=./data/uploads
PAPER_DATA_DIR=./data/papers
MAX_UPLOAD_MB=50
